# Copier ce fichier en .env.local et renseigner les valeurs. Ne jamais committer .env.local.

# Supabase (projet dashboards-ia, région Paris). La clé publishable est publique par conception :
# la sécurité repose sur la RLS. Aucune clé service_role n'est utilisée par l'application.
NEXT_PUBLIC_SUPABASE_URL=https://qiwkeisfhdndllyjjnhw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL publique de l'application, utilisée dans les liens envoyés par email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé secrète de pseudonymisation (HMAC). Obligatoire en production.
# Générer avec : openssl rand -base64 32
PSEUDONYMIZATION_KEY=

# Fournisseur IA : anthropic | vertex | bedrock | demo.
# Production avec données réelles : vertex (Google Cloud, UE) ou bedrock (AWS Paris) uniquement.
# Sans configuration, le mode demo est utilisé automatiquement (pas d'appel à un modèle).
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Modèle Claude (par défaut : claude-opus-5-5).
CLAUDE_MODEL=

# Claude sur Google Vertex AI, traitement dans l'UE (AI_PROVIDER=vertex).
VERTEX_PROJECT_ID=
# Région multi-UE par défaut : eu (ou une région précise, ex. europe-west1).
VERTEX_REGION=eu
# JSON du compte de service (rôle « Vertex AI User »). À stocker dans les secrets Vercel, jamais dans le dépôt.
GOOGLE_VERTEX_CREDENTIALS=

# Claude sur Amazon Bedrock, région Paris (AI_PROVIDER=bedrock).
# Identifiants AWS lus dans l'environnement : AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
BEDROCK_REGION=eu-west-3
# Identifiant du modèle ou du profil d'inférence UE (par défaut : anthropic.<CLAUDE_MODEL>).
BEDROCK_MODEL=
